class Solution {
    public int[] runningSum(int[] nums) {
        int n = nums.length;
        int arr[]= new int[n];
        int res = 0;

        for(int i=0; i<n; i++){
              res = res+nums[i];
            arr[i]= res;

        }
        return arr;   
    }
}
