class Solution {
    public int[] shuffle(int[] nums, int n) {
        int l = nums.length;
        int arr []= new int[l];
        for(int i=0; i<n; i++){
          arr[2*i]= nums[i];
          arr[2*i+1]= nums[n+i];
        }
        
       return arr; 
    }
}
